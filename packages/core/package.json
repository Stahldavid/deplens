{
  "name": "@deplens/core",
  "version": "1.0.9",
  "description": "Core engine for inspecting installed package exports and types",
  "type": "module",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./parse-dts": {
      "types": "./src/parse-dts.d.ts",
      "default": "./src/parse-dts.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stahldavid/deplens.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Stahldavid/deplens#readme",
  "bugs": {
    "url": "https://github.com/Stahldavid/deplens/issues"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "import-meta-resolve": "^4.2.0",
    "semver": "^7.8.5",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config vitest.config.mjs"
  }
}
