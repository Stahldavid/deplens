{
  "name": "@deplens/mcp",
  "version": "0.5.0",
  "description": "Model Context Protocol server for DepLens — inspect installed npm packages (exports, types, docs, examples) and diff versions.",
  "type": "module",
  "main": "./src/server.mjs",
  "bin": {
    "deplens-mcp": "bin/deplens-mcp.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stahldavid/deplens.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Stahldavid/deplens#readme",
  "bugs": {
    "url": "https://github.com/Stahldavid/deplens/issues"
  },
  "scripts": {
    "build": "echo 'no build'",
    "test": "vitest run",
    "start": "node bin/deplens-mcp.js",
    "inspector": "npx --yes @modelcontextprotocol/inspector node bin/deplens-mcp.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deplens/core": "0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deplens",
    "npm",
    "dependency",
    "inspect",
    "types",
    "diff"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
